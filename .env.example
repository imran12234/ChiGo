# Copy to .env and fill in values. Never commit the populated .env.
OPENAI_API_KEY=

# Server-only key. Enable Places API (New); configure suitable server restrictions.
PLACES_API_KEY=

# Separate public browser key, restricted to Maps JavaScript API.
# Add website restrictions for the origins you actually use, for example:
# http://localhost:8000/*
# http://127.0.0.1:8000/*
# https://chi-go-v2.onrender.com/*
GOOGLE_MAPS_BROWSER_KEY=

# Development only default; use your own map ID for deployment.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Existing database configuration (required to run the full app).
DATABASE_URL=
DEBUG=True
